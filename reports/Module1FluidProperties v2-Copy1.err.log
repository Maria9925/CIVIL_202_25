def quitar_tag_remove_cell(nombre_archivo, tag_buscado, tag_a_quitar):
    # Cargar el notebook
    with open(nombre_archivo, 'r', encoding='utf-8') as f:
        notebook = nbformat.read(f, as_version=4)
    
    # Iterar sobre todas las celdas
    for cell in notebook.cells:
        # Verificar si la celda tiene el tag 'solution'
        if 'tags' in cell.metadata and tag_buscado in cell.metadata['tags']:
            # Si tiene el tag 'remove-cell', eliminarlo
            if tag_a_quitar in cell.metadata['tags']:
                cell.metadata['tags'].remove(tag_a_quitar)
    
    # Guardar los cambios en el notebook
    with open(nombre_archivo, 'w', encoding='utf-8') as f:
        nbformat.write(notebook, f)
    
    # Confirmación para el usuario
    display(HTML('<b>El tag "remove-cell" ha sido eliminado de las celdas con tag "solution".</b>'))

# Llamar a la función dentro del notebook
quitar_tag_remove_cell('Module1FluidProperties v2-Copy1.ipynb', 'solution', 'remove-cell')
